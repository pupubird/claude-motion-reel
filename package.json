{
  "name": "claude-motion-reel",
  "version": "1.0.0",
  "description": "Motion reels rendered entirely from code: three.js + canvas + GLSL + WebAudio",
  "scripts": {
    "preview": "python3 -m http.server 5173",
    "render": "node projects/claude-reel/render.mjs",
    "stills": "node projects/claude-reel/render.mjs --samples=1 --stills=100,240,400,520,600,750,850",
    "aw:render": "node projects/adswinning/render.mjs --workers=3",
    "aw:stills": "node projects/adswinning/render.mjs --samples=1 --stills=20,300,452,745,905,1040,1230,1300,1470,1690",
    "aw:audio": "node projects/adswinning/render.mjs --audio && python3 projects/adswinning/tools/check_audio.py projects/adswinning/out/soundtrack.wav",
    "aw:check": "python3 projects/adswinning/tools/check_frames.py projects/adswinning/out/adswinning-showreel-2026.mp4 && python3 projects/adswinning/tools/check_audio.py projects/adswinning/out/soundtrack.wav",
    "zm:assets": "sh projects/zemyth/tools/prep_assets.sh",
    "zm:render": "node projects/zemyth/render.mjs --samples=8 --workers=3",
    "zm:stills": "node projects/zemyth/render.mjs --samples=1 --stills=150,300,500,820,1000,1300,1440,1700",
    "zm:check": "python3 projects/zemyth/tools/check_frames.py projects/zemyth/out/zemyth-reel-2026.mp4 && python3 projects/zemyth/tools/check_audio.py projects/zemyth/out/soundtrack.wav",
    "np:assets": "sh projects/novapitch/tools/prep_assets.sh",
    "np:stills": "node projects/novapitch/render.mjs --samples=1 --stills=120,400,600,800,1080,1440,1600,1800,2000,2280,2600,2900,3300",
    "np:audio": "node projects/novapitch/render.mjs --audio && python3 projects/novapitch/tools/check_audio.py projects/novapitch/out/soundtrack.wav",
    "np:render": "node projects/novapitch/render.mjs --samples=8 --workers=3",
    "np:check": "python3 projects/novapitch/tools/check_frames.py projects/novapitch/out/novapitch-film-2026.mp4 && python3 projects/novapitch/tools/check_audio.py projects/novapitch/out/soundtrack.wav",
    "np:read": "node projects/novapitch/tools/check_reading.mjs",
    "fy:render": "node projects/feiyuehui/v4/render.mjs",
    "fy:audio": "python3 projects/feiyuehui/v4/tools/sfx.py && python3 projects/feiyuehui/v4/tools/mix.py --score c6",
    "fy:check": "python3 projects/feiyuehui/v4/tools/check_frames.py projects/feiyuehui/v4/out/feiyuehui-v4.mp4 && python3 projects/feiyuehui/v4/tools/check_audio.py projects/feiyuehui/v4/out/feiyuehui-v4.mp4",
    "fy:real": "python3 projects/feiyuehui/v4/tools/v2v_comp.py --selftest && python3 projects/feiyuehui/v4/tools/v2v_edit.py projects/feiyuehui/v4/tools/real_edit.json projects/feiyuehui/v4/out/feiyuehui-v4-real.mp4 && python3 projects/feiyuehui/v4/tools/check_frames.py projects/feiyuehui/v4/out/feiyuehui-v4-real.mp4 && python3 projects/feiyuehui/v4/tools/check_audio.py projects/feiyuehui/v4/out/feiyuehui-v4-real.mp4",
    "af:stills": "node projects/almostfriends/render.mjs --samples=8 --stills=0,0.9s,2.9s,9.7s,17.3s,32.3s,49.5s,51.9s,61s,64.5s",
    "af:audio": "node projects/almostfriends/tools/cues.mjs > projects/almostfriends/audio/cues.json && python3 projects/almostfriends/tools/foley.py && python3 projects/almostfriends/tools/mix.py --score v6a-s --swell 1.4,2.0 --breath 48 --tp -2",
    "af:render": "node projects/almostfriends/render.mjs --samples=16 --workers=3 --crf=14 --wav=projects/almostfriends/audio/mix.wav --out=projects/almostfriends/out/almostfriends-reel-2026.mp4",
    "af:render4k": "node projects/almostfriends/render.mjs --samples=16 --workers=3 --scale=2 --crf=16 --wav=projects/almostfriends/audio/mix.wav --out=projects/almostfriends/out/almostfriends-reel-2026-4k.mp4",
    "af:check": "python3 projects/almostfriends/tools/check_frames.py projects/almostfriends/out/almostfriends-reel-2026.mp4 && python3 projects/almostfriends/tools/check_jumps.py projects/almostfriends/out/almostfriends-reel-2026.mp4 --allow=0.25,0.5,36.25,38.25",
    "af:read": "node projects/almostfriends/tools/check_reading.mjs",
    "af:audio:zh": "node projects/almostfriends/tools/cues.mjs --lang=zh > projects/almostfriends/audio/cues-zh.json && python3 projects/almostfriends/tools/foley.py --cues projects/almostfriends/audio/cues-zh.json --out projects/almostfriends/audio/foley-zh.wav && python3 projects/almostfriends/tools/mix.py --score v6a-s --swell 1.4,2.0 --breath 48 --tp -2 --foley foley-zh.wav --out mix-zh.wav",
    "af:render:zh": "node projects/almostfriends/render.mjs --lang=zh --samples=16 --workers=3 --crf=14 --wav=projects/almostfriends/audio/mix-zh.wav --out=projects/almostfriends/out/almostfriends-reel-2026-zh.mp4",
    "af:check:zh": "python3 projects/almostfriends/tools/check_frames.py projects/almostfriends/out/almostfriends-reel-2026-zh.mp4 && python3 projects/almostfriends/tools/check_jumps.py projects/almostfriends/out/almostfriends-reel-2026-zh.mp4 --allow=0.25,0.5,36.25,38.25",
    "af:read:zh": "node projects/almostfriends/tools/check_reading.mjs --lang=zh",
    "afs:stills": "node projects/almostfriends-special/render.mjs --samples=8 --stills=2.2s,3.3s,13.6s,14.88s,17s,20.3s,22.75s,23.9s,32.3s,46.5s,50.45s,50.9s,59.6s,61.9s,64.5s",
    "afs:render": "node projects/almostfriends-special/render.mjs --samples=16 --workers=3 --crf=14 --wav=projects/almostfriends/audio/mix.wav --out=projects/almostfriends-special/out/almostfriends-special-2026.mp4",
    "afs:render4k": "node projects/almostfriends-special/render.mjs --samples=16 --workers=3 --scale=2 --crf=16 --wav=projects/almostfriends/audio/mix.wav --out=projects/almostfriends-special/out/almostfriends-special-2026-4k.mp4",
    "afs:check": "python3 projects/almostfriends-special/tools/check_frames.py projects/almostfriends-special/out/almostfriends-special-2026.mp4 && python3 projects/almostfriends-special/tools/check_jumps.py projects/almostfriends-special/out/almostfriends-special-2026.mp4 --allow=0.25,0.5,36.25,38.25 && node projects/almostfriends-special/tools/check_liquid.mjs",
    "afs:read": "node projects/almostfriends-special/tools/check_reading.mjs",
    "afs:render:zh": "node projects/almostfriends-special/render.mjs --lang=zh --samples=16 --workers=3 --crf=14 --wav=projects/almostfriends/audio/mix-zh.wav --out=projects/almostfriends-special/out/almostfriends-special-2026-zh.mp4",
    "afs:render4k:zh": "node projects/almostfriends-special/render.mjs --lang=zh --samples=16 --workers=3 --scale=2 --crf=16 --wav=projects/almostfriends/audio/mix-zh.wav --out=projects/almostfriends-special/out/almostfriends-special-2026-zh-4k.mp4",
    "afs:check:zh": "python3 projects/almostfriends-special/tools/check_frames.py projects/almostfriends-special/out/almostfriends-special-2026-zh.mp4 && python3 projects/almostfriends-special/tools/check_jumps.py projects/almostfriends-special/out/almostfriends-special-2026-zh.mp4 --allow=0.25,0.5,36.25,38.25",
    "afs:read:zh": "node projects/almostfriends-special/tools/check_reading.mjs --lang=zh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "lucide": "^1.48.0",
    "opentype.js": "^1.3.4",
    "playwright-core": "^1.63.0",
    "three": "^0.186.1"
  },
  "private": true
}
