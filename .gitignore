node_modules/
out/
.DS_Store
ffmpeg2pass-*
# raw AI generations (large); prep_ads.py sizes them into assets/ads/
projects/adswinning/assets/raw/
# Zemyth: the client's footage, photos and commercially licensed fonts are not redistributable.
# tools/prep_assets.sh copies them from a local checkout of the Zemyth website.
projects/zemyth/assets/footage/
projects/zemyth/assets/img/
projects/zemyth/assets/fonts/refinery-95-bold.ttf
projects/zemyth/assets/fonts/BlenderPro-*.ttf

# Nova Pitch: the client's showroom deck (rasterised) and demo marks; tools/prep_assets.sh copies them from a
# local checkout of the product repo. Take audit files and the music takes that were not used stay local too.
projects/novapitch/assets/slides/
projects/novapitch/assets/brand/
projects/novapitch/assets/music/v1/
projects/novapitch/assets/music/t*.mp3
projects/novapitch/assets/music/t*.json
projects/novapitch/assets/vo/answer_*.mp3
projects/novapitch/assets/vo/answer_*.json

# local secrets (never commit)
.env
.env.*

# 翡月荟 (reel 05): the client's images, mirrored from its site with the client's consent (2026-09-30), and everything
# built from them stay local: the three.js package (shared/assets/3d), the logo traces (shared/assets/derived), the
# Seedance takes and their reference photos (v4/out, ignored above). Only v4, the source of the released film, is
# published; the earlier iterations (v1–v3, ~570 MB of fonts, textures and stems) and the shared production assets
# (score and voice takes, hand-off notes) stay local too.
projects/feiyuehui/shared/
projects/feiyuehui/v1/
projects/feiyuehui/v2/
projects/feiyuehui/v3/
# v4: tools/mix.py rebuilds the stems and the mix; of the score takes only c6 (the score) is kept; look-dev stills show
# the client's pieces
projects/feiyuehui/v4/audio/*.wav
projects/feiyuehui/v4/audio/music/*
!projects/feiyuehui/v4/audio/music/c6.mp3
!projects/feiyuehui/v4/audio/music/c6.json
projects/feiyuehui/v4/audio/**/*.log
projects/feiyuehui/v4/lookdev/

# almost friends (reel 06): third-party UI reference screenshots (Mobbin captures, private reference), the full-size
# portrait downloads and look-dev tests, the earlier casts (v1–v5), the score takes and generated stems (tools/music.py,
# foley.py and mix.py rebuild them; each take's song id is in audio/music/<take>.json; the released score is committed
# as audio/music/v6a-s.mp3), and the review pages with the animatic of every iteration. The release holds the film.
projects/almostfriends/research/ui-refs/
projects/almostfriends/assets/people/raw/
projects/almostfriends/assets/people/tests/
projects/almostfriends/assets/people/v4/
projects/almostfriends/audio/*.wav
projects/almostfriends/audio/music/*.wav
projects/almostfriends/audio/music/*.log
projects/almostfriends/docs/storyboard/

# almost friends — special edition. v6 plays the released film's mix, so it has no audio of its own. v5 (the first
# special edition, archived in v5/): its score takes stay local except the chosen one (s3, as FLAC); its mixes and stems
# are rebuilt by v5/tools/mix.py from the cue sheet and the effects library
projects/almostfriends-special/v5/audio/music/*.wav
projects/almostfriends-special/v5/audio/mix*.wav
projects/almostfriends-special/v5/audio/stem-*.wav
